# Supabase Configuration
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anonyme-publique-supabase

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=votre-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=votre-upload-preset-non-signe

# WhatsApp (valeur par défaut, modifiable dans Admin › Réglages)
VITE_WHATSAPP_NUMBER=
# Indicatif utilisé pour les numéros saisis sans « + » (229 = Bénin, 225 = Côte d'Ivoire, 33 = France)
VITE_WHATSAPP_COUNTRY_CODE=229

# URL publique du site (sitemap, balises canonical, pré-rendu SEO au build)
VITE_SITE_URL=https://www.exemple.com
